//@version=6
// @author Ertha Dwi Setiyawan
indicator("Elliott Wave MTF Pro", shorttitle = "EW MTF", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 250)

// -- Types ---------------------------------------------------------------
type Pivot
    float price
    int time
    int dir
    float osc

// kind: 1 = impulse or diagonal, 2 = correction (ABC, WXY, WXYXZ), 3 = triangle.
// dir is the direction of the move. role (triangle only): 4 = wave 4, 2 = wave B.
// wLen: wave W of a correction (for the next Y or Z), the widest leg of a wave 4
// triangle, or wave A before a wave B triangle. hasShelf: this pattern replaced the
// previous correction, which is kept hidden on the layer shelf until this one is cancelled.
type Pattern
    int kind
    int dir
    int startTime
    int endTime
    float startPrice
    float endPrice
    float score
    array<line> lines
    array<label> labels
    int role = 0
    string name = ""
    float wLen = na
    bool hasShelf = false
    array<int> labDirs
    array<string> labBase
    // Impulse only: ext is the motive wave that extended into five sub-waves (1, 3 or 5,
    // 0 for none); extW2 is the wave 2 end inside an extended wave 5 (double retracement target).
    int ext = 0
    float extW2 = na

// Order block or supply / demand zone. dir 1 is bullish (demand), -1 bearish (supply).
type PaZone
    box b
    int dir
    bool active
    string txt
    color c
    int rank
    int touches = 0
    int lastTouch = na
    float depth = na
    int bgT = 85
    int quality = -1
    int leftTime = na
    int bornBar = na

type Gap
    box b
    float top
    float bot
    bool bull
    float depth = na
    int left = na

// Support / resistance zone from merged pivots. role: 1 support, -1 resistance.
type Zone
    float price
    int touches
    int bornTime
    int role
    string tf

type SrCand
    float price
    float half
    int role
    string txt
    int born
    bool used = false

type LiqLevel
    float price
    bool buySide
    bool equalLevel
    line ln
    label tag

// One leg of a projected path. t is the estimated end time; t0 and y0 (start time and price)
// are set on the first leg of each scenario only. lc and tc are the line and text colours
// restored when a hidden leg shows again; dir and base rebuild the label text.
type PathLeg
    line ln
    label lb
    int t
    int t0
    float y0
    color lc
    color tc
    string tip
    int dir
    string base
    bool hide = false

// One wave degree. setupKind: 1 = wave 3 developing, 2 = wave 5 developing,
// 3 = impulse complete, 4 = wave C developing, 5 = wave 4 pullback,
// 6 = correction complete, 7 = wave 5 thrust after a wave 4 triangle,
// 8 = candidate count from the last swings when no rule-based count fits (candDir is
// its direction; bias stays 0 so it never feeds signals, filters or OB quality).
// px: close of the last finished bar of the layer's timeframe.
type Layer
    string name
    string tag
    string tfText
    int deg
    color col
    bool active
    bool show
    bool proj
    array<Pivot> pivots
    array<Pattern> patterns
    array<line> projLines
    array<label> projLabels
    array<box> projBoxes
    array<PathLeg> path
    array<line> devLines
    array<label> devLabels
    array<int> devDirs
    array<string> devBase
    array<string> projTexts
    array<color> projCols
    array<Pattern> shelf
    float px = na
    // px when the count was last rebuilt, so a deferred render reproduces the same targets.
    float procPx = na
    bool altDraw = false
    int altDir = 0
    int altT0 = na
    float altP0 = na
    float altInv = na
    float altOver = na
    int altMs = na
    int altStart = -1
    int replacedTime = 0
    string state = "Belum ada hitungan valid"
    string swingTxt = "-"
    int setupKind = 0
    int candDir = 0
    int bias = 0
    float inv = na
    float target = na
    int tgtDir = 0
    float trigger = na
    float stopRef = na
    float invHit = na
    bool triggerFired = false
    bool targetHit = false
    float score = na
    float setupScore = na
    string fracTxt = ""
    // S/R zone or liquidity level the target coincides with ("" for none), set on the last bar.
    string tgtConf = ""
    // ATR of the layer's own timeframe, the scale of the confluence tolerance for its levels.
    float atrTf = na
    // Projections are drawn only while live (the last bars); on older bars the count is
    // computed without drawings and renderPending asks step() to draw it once on the last bar.
    bool live = false
    bool renderPending = false
    // First leg of the primary path (start time and price, end time and price), kept as
    // data so the alternative scenario does not depend on drawn objects.
    int leg0T0 = na
    float leg0P0 = na
    int leg0T1 = na
    float leg0Y = na
    int evImpulse = 0
    bool evDiv = false
    bool evEndDiag = false
    int evCorr = 0
    bool evTri = false
    int evTrigger = 0
    bool evInvalid = false
    bool evTarget = false

// -- Inputs --------------------------------------------------------------
// Each feature group starts with its master switch; the inputs below it use
// active = <master> so they are greyed out while the feature is off.
string gEng = "01 - Elliott Wave"
bool ewOn = input.bool(true, "Aktifkan Elliott Wave", group = gEng,
     tooltip = "Bila tidak dicentang, seluruh hitungan, gambar gelombang, proyeksi, zona reaksi, sinyal, dan peringatan Elliott Wave dimatikan. Bias Elliott Wave pada kualitas OB juga tidak dipakai.")
int rsiLen = input.int(14, "Panjang RSI momentum", minval = 2, group = gEng, active = ewOn,
     tooltip = "Nilai RSI disimpan di setiap pivot. RSI di puncak gelombang 5 yang lebih rendah daripada di puncak gelombang 3 (atau kebalikannya pada tren turun) dihitung sebagai divergensi momentum.")
int minScore = input.int(45, "Skor impuls minimum", minval = 0, maxval = 100, group = gEng, active = ewOn,
     tooltip = "Impuls harus lolos semua aturan Elliott dan mencapai skor pedoman ini sebelum digambar. Skor memakai rasio Fibonacci EWF: gelombang 2 = 50-85.4% gelombang 1, gelombang 3 = 161.8/200/261.8/323.6% gelombang 1, gelombang 4 = 14.6-38.2% gelombang 3 (maksimal 50%), gelombang 5 = gelombang 1, 61.8% gelombang 1-3, atau 123.6-161.8% gelombang 4.")
bool needDiv = input.bool(false, "Divergensi gelombang 5 wajib", group = gEng, active = ewOn,
     tooltip = "EWF menyebut gelombang 5 perlu diakhiri divergensi momentum. Aktifkan agar hanya impuls dengan divergensi RSI yang digambar.")
bool allowDiag = input.bool(true, "Izinkan diagonal (bentuk baji dengan overlap)", group = gEng, active = ewOn,
     tooltip = "Diagonal harus berbentuk baji dan gelombang 4 masuk ke wilayah gelombang 1. Tanpa overlap, pola dihitung sebagai impuls. Diagonal awal (leading) muncul sebagai gelombang 1 atau A. Diagonal akhir (ending) muncul sebagai gelombang 5 atau C dan menandakan tren melemah. Struktur internal 5-3-5-3-5 atau 3-3-3-3-3 tidak dapat diperiksa dari satu derajat pivot.")
bool allowTrunc = input.bool(false, "Izinkan gelombang 5 terpotong (truncation)", group = gEng, active = ewOn)
bool needBos = input.bool(true, "Gelombang 1 wajib menembus swing sebelumnya", group = gEng, active = ewOn,
     tooltip = "Hitungan gelombang 1-2, 1-2-3, 1-2-3-4, dan impuls selesai hanya diterima jika gelombang 1 menembus swing high sebelumnya (tren naik) atau swing low sebelumnya (tren turun). Syarat ini menyaring hitungan yang dimulai di tengah koreksi.")
bool detectTri = input.bool(true, "Deteksi triangle ABCDE (gelombang 4 atau B)", group = gEng, active = ewOn)
bool detectCombo = input.bool(true, "Deteksi koreksi kombinasi WXY dan WXYXZ", group = gEng, active = ewOn,
     tooltip = "WXY (7 swing) dan WXYXZ (11 swing). X = 50-85.4% dari W, Y dan Z = 61.8/100/123.6% dari W, dan Y tidak boleh melewati 161.8% dari W.")
bool showWavePrice = input.bool(true, "Tampilkan harga pada label gelombang dan jalur proyeksi", group = gEng, active = ewOn,
     tooltip = "Menuliskan harga di samping nama gelombang, misalnya 0  74512.3 atau a?  68210.5, pada gelombang selesai, hitungan berjalan, awal 0, dan titik perkiraan jalur proyeksi. Level target sudah selalu menampilkan harga.")
bool showRatios = input.bool(true, "Tampilkan rasio Fibonacci pada label gelombang", group = gEng, active = ewOn)
int maxPatterns = input.int(8, "Jumlah pola selesai yang disimpan per derajat", minval = 1, maxval = 25, group = gEng, active = ewOn,
     tooltip = "Impuls terakhir tetap disimpan walaupun melebihi batas ini, karena koreksi berikutnya diukur dari impuls tersebut.")
int projBars = input.int(25, "Panjang proyeksi (bar)", minval = 5, maxval = 300, group = gEng, active = ewOn)
string projDetail = input.string("Ringkas", "Detail proyeksi", options = ["Ringkas", "Lengkap"], group = gEng, active = ewOn,
     tooltip = "Ringkas: zona utama, target terpilih (garis tegas), pemicu gelombang 3, dan invalidasi. Lengkap: ditambah semua level Fibonacci alternatif (garis titik-titik).")
bool showPath = input.bool(true, "Jalur gelombang ke depan", group = gEng, active = ewOn,
     tooltip = "Menggambar garis putus-putus dari pivot terakhir melalui gelombang berikutnya yang diperkirakan (misalnya 3? 4? 5? atau A? B? C?) pada derajat yang proyeksinya aktif. Harga memakai rasio Fibonacci yang sama dengan level proyeksi. Waktu tiap titik diperkirakan dari durasi gelombang sebelumnya, dan harga dapat mencapainya lebih cepat atau lebih lambat.")
bool showAlt = input.bool(true, "Skenario positif dan negatif", group = gEng, active = ewOn and showPath,
     tooltip = "Selain jalur skenario utama, digambar jalur skenario berlawanan arah: bila hitungan batal, harga bergerak zigzag melewati level invalidasi sejauh 0.618 kaki pertama skenario utama (bear case paling dalam setengah harga invalidasi). Titik akhir tiap jalur diberi tanda Bull case atau Bear case, jalur dimulai dari candle terakhir, dan target yang sudah tercapai disembunyikan. Skenario yang memproyeksikan harga nol atau negatif tidak digambar. Jalur naik (positif) memakai warna naik, jalur turun (negatif) memakai warna turun. Skenario utama bergaris putus-putus, skenario alternatif bergaris titik-titik.")
string altScope = input.string("Derajat sinyal", "Skenario alternatif pada", options = ["Derajat sinyal", "Semua derajat"], group = gEng, active = ewOn and showPath and showAlt,
     tooltip = "Derajat sinyal: jalur alternatif digambar pada satu derajat saja, yaitu derajat sinyal (grup 06). Bila derajat itu tidak punya hitungan atau proyeksinya mati, dipakai derajat Major, timeframe besar 1, timeframe besar 2, lalu Minor. Semua derajat: setiap derajat yang proyeksinya aktif mendapat jalur alternatif. Setelah hitungan utama batal, jalur alternatif tetap tampil sampai pivot berikutnya terkonfirmasi.")
bool showCand = input.bool(true, "Hitungan kandidat bila belum ada hitungan valid", group = gEng, active = ewOn,
     tooltip = "Bila swing terakhir belum memenuhi aturan hitungan mana pun (sering terjadi di timeframe mingguan dan bulanan karena jumlah pivot sedikit), swing terakhir diperlakukan sebagai kandidat gelombang 1 atau 1-2, lengkap dengan proyeksi dan level invalidasi. Kandidat tidak memicu sinyal, tidak dipakai filter timeframe besar, dan tidak menambah kualitas OB.")
bool autoLen = input.bool(true, "Sesuaikan panjang pivot di timeframe mingguan dan bulanan", group = gEng, active = ewOn,
     tooltip = "Pada timeframe 1W ke atas, panjang pivot dikalikan 0.6, dan pada 1M ke atas dikalikan 0.4 (minimal 2). Tanpa ini, puncak atau dasar di chart bulanan baru terkonfirmasi setelah 13 bulan.")
int swingLook = input.int(30, "Jumlah pivot untuk hitungan swing", minval = 6, maxval = 150, group = gEng, active = ewOn,
     tooltip = "Hitungan swing dimulai dari titik tertinggi atau terendah terakhir di dalam rentang pivot ini.")

string gD1 = "02 - Elliott Wave: derajat Minor (timeframe chart)"
bool en1 = input.bool(true, "Aktif", group = gD1, active = ewOn)
bool show1 = input.bool(true, "Gambar gelombang", group = gD1, active = ewOn and en1)
bool proj1 = input.bool(false, "Proyeksi", group = gD1, active = ewOn and en1)
int len1 = input.int(5, "Panjang pivot", minval = 2, maxval = 50, group = gD1, active = ewOn and en1)
color col1 = input.color(#26a69a, "Warna", group = gD1, active = ewOn and en1)

string gD2 = "03 - Elliott Wave: derajat Major (timeframe chart)"
bool en2 = input.bool(true, "Aktif", group = gD2, active = ewOn)
bool show2 = input.bool(true, "Gambar gelombang", group = gD2, active = ewOn and en2)
bool proj2 = input.bool(true, "Proyeksi", group = gD2, active = ewOn and en2)
int len2 = input.int(13, "Panjang pivot", minval = 2, maxval = 100, group = gD2, active = ewOn and en2)
color col2 = input.color(#2962ff, "Warna", group = gD2, active = ewOn and en2)

// The higher timeframes also feed the S/R and OB / S&D zones, so their switch and
// timeframe stay editable while Elliott Wave is off.
string gD3 = "04 - Elliott Wave: timeframe besar 1"
bool en3 = input.bool(true, "Aktif", group = gD3)
bool show3 = input.bool(true, "Gambar gelombang", group = gD3, active = ewOn and en3)
bool proj3 = input.bool(true, "Proyeksi", group = gD3, active = ewOn and en3)
string tfMode3 = input.string("Auto", "Timeframe", options = ["Auto", "Manual"], group = gD3, inline = "tf3", active = en3,
     tooltip = "Auto memilih timeframe standar pertama yang minimal 4 kali timeframe chart. Data timeframe besar hanya memakai bar yang sudah ditutup, sehingga hitungan tidak repaint. Timeframe ini juga dipakai zona support dan resistance serta OB dan S&D timeframe besar 1.")
string tfMan3 = input.timeframe("240", "", group = gD3, inline = "tf3", active = en3)
int len3 = input.int(5, "Panjang pivot", minval = 2, maxval = 50, group = gD3, active = ewOn and en3)
color col3 = input.color(#ab47bc, "Warna", group = gD3, active = ewOn and en3)

string gD4 = "05 - Elliott Wave: timeframe besar 2"
bool en4 = input.bool(true, "Aktif", group = gD4)
bool show4 = input.bool(false, "Gambar gelombang", group = gD4, active = ewOn and en4)
bool proj4 = input.bool(false, "Proyeksi", group = gD4, active = ewOn and en4)
string tfMode4 = input.string("Auto", "Timeframe", options = ["Auto", "Manual"], group = gD4, inline = "tf4", active = en4,
     tooltip = "Auto memilih timeframe standar pertama yang minimal 4 kali timeframe besar 1. Timeframe ini juga dipakai zona support dan resistance serta OB dan S&D timeframe besar 2.")
string tfMan4 = input.timeframe("D", "", group = gD4, inline = "tf4", active = en4)
int len4 = input.int(5, "Panjang pivot", minval = 2, maxval = 50, group = gD4, active = ewOn and en4)
color col4 = input.color(#ff9800, "Warna", group = gD4, active = ewOn and en4)

string gSig = "06 - Elliott Wave: sinyal, zona reaksi, dan peringatan"
bool showW3 = input.bool(true, "Sinyal breakout gelombang 3", group = gSig, active = ewOn,
     tooltip = "BELI atau JUAL saat candle ditutup melewati ujung gelombang 1 setelah gelombang 2 yang valid. Stop: ujung gelombang 2. Target: gelombang 3 di 1.618 kali gelombang 1.")
bool showCSig = input.bool(true, "Sinyal koreksi selesai", group = gSig, active = ewOn,
     tooltip = "BELI atau JUAL saat koreksi (ABC, WXY, atau WXYXZ) yang berlawanan dengan impuls sebelumnya terkonfirmasi. Koreksi yang melewati awal impuls tidak dihitung. Stop: ujung koreksi. Target: awal koreksi.")
bool showExh = input.bool(true, "Peringatan akhir gelombang 5", group = gSig, active = ewOn,
     tooltip = "Menandai impuls selesai yang diakhiri divergensi momentum atau diagonal akhir (ending diagonal). Ini peringatan pembalikan, bukan sinyal entry.")
string sigDeg = input.string("Major", "Derajat sinyal", options = ["Minor", "Major"], group = gSig, active = ewOn)
string htfFilter = input.string("Tidak berlawanan", "Filter timeframe besar", options = ["Ketat", "Tidak berlawanan", "Mati"], group = gSig, active = ewOn,
     tooltip = "Menjumlahkan bias timeframe besar yang aktif. Ketat: jumlahnya harus searah dengan sinyal. Tidak berlawanan: jumlahnya boleh netral. Mati: tanpa filter.")
float minRR = input.float(1.5, "Rasio reward / risk minimum", minval = 0.0, step = 0.1, group = gSig, active = ewOn,
     tooltip = "Rasio reward / risk adalah jarak dari harga penutupan candle sinyal ke target dibagi jaraknya ke stop. Sinyal gelombang 3 dan koreksi selesai dengan rasio di bawah nilai ini tidak ditampilkan. Pivot baru terkonfirmasi beberapa candle setelah terbentuk, sehingga saat sinyal muncul harga bisa sudah jauh dari stop. Isi 0 untuk mematikan filter.")
int minGrade = input.int(1, "Kualitas sinyal minimum (0-3)", minval = 0, maxval = 3, group = gSig, active = ewOn,
     tooltip = "Satu poin untuk tiap syarat yang terpenuhi: bias timeframe besar searah sinyal; resistansi terdekat (beli) atau support terdekat (jual) berjarak paling sedikit sejauh stop dan RSI belum jenuh (di bawah 70 untuk beli, di atas 30 untuk jual); skor pola minimal 60 (gelombang 2 untuk sinyal gelombang 3, koreksi untuk sinyal koreksi). Poin tertulis pada label sinyal, misalnya W3 BELI 2/3. Sinyal di bawah nilai minimum tidak ditampilkan dan tidak memicu kondisi alert sinyal beli atau jual.")
bool showZone = input.bool(true, "Tampilkan zona reaksi (100-161.8%)", group = gSig, inline = "z", active = ewOn,
     tooltip = "Area akhir koreksi: gelombang C, Y, atau Z sepanjang 100 sampai 161.8% dari gelombang A atau W. Reaksi harga lebih mungkin terjadi di area ini.")
color colZone = input.color(#2196f3, "", group = gSig, inline = "z", active = ewOn and showZone)
bool alertsOn = input.bool(true, "Kirim peringatan kejadian", group = gSig, active = ewOn,
     tooltip = "Perlu alert dengan kondisi 'Any alert() function call'. Mengirim satu pesan per kejadian saat candle ditutup: impuls selesai, koreksi selesai, triangle selesai, breakout gelombang 3, target tercapai, dan invalidasi.")

string gCyc = "06b - Elliott Wave: siklus waktu dan konfluensi target"
bool cycOn = input.bool(true, "Tampilkan siklus waktu", group = gCyc, active = ewOn,
     tooltip = "Garis vertikal di low siklus sebelumnya dan di perkiraan dasar siklus berikutnya. Ini perkiraan waktu, bukan level harga. Dasbor menampilkan panjang siklus dan sisa waktunya.")
string cycMode = input.string("Otomatis", "Sumber siklus", options = ["Otomatis", "Manual"], group = gCyc, active = ewOn and cycOn,
     tooltip = "Otomatis: panjang siklus adalah rata-rata jarak waktu antar-low pivot pada satu derajat gelombang, sehingga menyesuaikan simbol dan timeframe. Jendela titik-titik di kiri dan kanan perkiraan adalah plus minus satu simpangan baku jarak tersebut. Manual: siklus kalender tetap dari tanggal jangkar, misalnya 48 bulan dari Januari 2023 untuk siklus 4 tahun Bitcoin.")
string cycDegIn = input.string("Derajat terbesar", "Derajat siklus (otomatis)", options = ["Derajat terbesar", "Minor", "Major", "TF besar 1", "TF besar 2"], group = gCyc,
     active = ewOn and cycOn and cycMode == "Otomatis",
     tooltip = "Derajat terbesar: derajat aktif tertinggi yang sudah punya cukup low pivot. Derajat lebih besar menghasilkan siklus lebih panjang.")
int cycSamples = input.int(3, "Jumlah siklus untuk rata-rata (otomatis)", minval = 1, maxval = 10, group = gCyc, active = ewOn and cycOn and cycMode == "Otomatis")
int cycAnchor = input.time(timestamp("01 Jan 2023 00:00 +0000"), "Tanggal jangkar (manual)", group = gCyc, active = ewOn and cycOn and cycMode == "Manual")
int cycMonths = input.int(48, "Panjang siklus dalam bulan (manual)", minval = 1, maxval = 240, group = gCyc, active = ewOn and cycOn and cycMode == "Manual")
bool confOn = input.bool(true, "Tandai target yang berkonfluensi", group = gCyc, active = ewOn,
     tooltip = "Level proyeksi Fibonacci yang berada di dalam atau dekat zona support / resistansi atau level likuiditas BSL / SSL diberi tanda ★ beserta level tersebut, juga pada kolom target dasbor. Toleransi mengikuti ATR timeframe derajat yang memproyeksikan level, sehingga menyesuaikan volatilitas. Hanya zona S/R dan likuiditas yang sedang tampil yang dipakai.")
float confAtr = input.float(1.0, "Toleransi konfluensi (x ATR timeframe derajat)", minval = 0.1, step = 0.1, group = gCyc, active = ewOn and confOn)

string gMa = "07 - EMA / MA"
bool showMa = input.bool(true, "Tampilkan moving average", group = gMa)
string maType = input.string("EMA", "Jenis", options = ["EMA", "SMA"], group = gMa, active = showMa)
int ma1Len = input.int(20, "Cepat", minval = 1, group = gMa, active = showMa)
int ma2Len = input.int(50, "Tengah", minval = 1, group = gMa, active = showMa)
int ma3Len = input.int(200, "Lambat", minval = 1, group = gMa, active = showMa)
bool maFill = input.bool(true, "Arsir di antara MA cepat dan tengah", group = gMa, active = showMa)

string gSr = "08 - Support dan resistance"
bool showSr = input.bool(true, "Tampilkan zona support dan resistance", group = gSr,
     tooltip = "Zona dibentuk dari pivot timeframe chart serta timeframe besar 1 dan 2. Pivot yang berdekatan (dalam lebar gabung dikali ATR timeframe tersebut) digabung menjadi satu zona, dan jumlah sentuhannya dihitung. Zona di atas harga menjadi resistansi, di bawah harga menjadi support.")
int srLen = input.int(5, "Panjang pivot timeframe chart", minval = 2, maxval = 50, group = gSr, active = showSr)
float srMerge = input.float(0.3, "Lebar gabung zona (x ATR)", minval = 0.05, step = 0.05, group = gSr, active = showSr)
float srThick = input.float(0.08, "Tebal zona (x ATR)", minval = 0.01, step = 0.01, group = gSr, active = showSr)
int srMinTouch = input.int(1, "Sentuhan minimum", minval = 1, group = gSr, active = showSr)
int srEach = input.int(3, "Zona di atas dan di bawah harga", minval = 1, maxval = 8, group = gSr, active = showSr)
float srMaxDist = input.float(20.0, "Sembunyikan zona lebih jauh dari (% dari harga)", minval = 1.0, step = 1.0, group = gSr, active = showSr)
bool srUseHtf = input.bool(true, "Sertakan zona timeframe besar 1 dan 2", group = gSr, active = showSr)
bool showSrBreakIn = input.bool(false, "Tandai S/R yang tertembus", group = gSr, active = showSr,
     tooltip = "TEMBUS R: candle ditutup di atas tepi atas resistansi terdekat. TEMBUS S: candle ditutup di bawah tepi bawah support terdekat. Hanya candle dengan badan minimal 0.8 ATR yang searah penembusan yang ditandai.")
color colSup = input.color(#26a69a, "Warna support", group = gSr, active = showSr)
color colRes = input.color(#ef5350, "Warna resistansi", group = gSr, active = showSr)
bool showSrBreak = showSr and showSrBreakIn

string gPa = "09 - Price action"
bool paOn = input.bool(true, "Aktifkan price action", group = gPa,
